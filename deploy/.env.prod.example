# Copia a deploy/.env.prod (ignorado por git) y completa los secretos.
# APP_DOMAIN es el host público proxied por Cloudflare, sin https://.
APP_DOMAIN=pescaderia.example.com

APP_ENV=production
APP_DEBUG=false
APP_URL=https://pescaderia.example.com
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_SECURE_COOKIE=true

# Base de datos (el contenedor db la crea en el primer arranque).
MYSQL_DATABASE=pescaderia
MYSQL_USER=pescaderia
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_DATABASE=pescaderia
DB_USERNAME=pescaderia
DB_PASSWORD=

# Primer administrador: se crea sólo al sembrar una base vacía.
SEED_ON_START=true
INITIAL_ADMIN_USER=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
