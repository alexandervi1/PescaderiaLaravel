import /etc/caddy/cloudflare-ips.caddy

# Proxy TLS delante de Apache. Cloudflare termina la conexión pública con el
# certificado de borde; aquí se usa el Cloudflare Origin Certificate para que
# el modo "Full (strict)" del panel funcione sin depender de Let's Encrypt.
{$APP_DOMAIN} {
	# Rechaza cualquier conexión que no venga de un rango de Cloudflare.
	import solo_cloudflare

	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	reverse_proxy app:80 {
		# IP real del visitante: tras el filtro solo entran peticiones de Cloudflare,
		# así que la cabecera siempre está presente y se puede confiar en ella.
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
		# Caddy no gestiona X-Forwarded-Port y dejaría pasar la del cliente; Laravel
		# confía en ella (TRUSTED_PROXIES=*) al generar URLs, así que se fija aquí.
		header_up X-Forwarded-Port 443
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
